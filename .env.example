# ==============================================================================
# EVALUATION SETUP: 3 Supported Execution Modes
# ==============================================================================
#
# OPTION A (Fastest Zero-Setup): Gemini Flash Cloud API
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=your_gemini_api_key_here
#   GEMINI_MODEL=gemini-2.5-flash
#
# OPTION B (100% Offline / Local Engine): Ollama
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=qwen2.5:1.5b   # or qwen2.5:7b
#
# OPTION C (Deterministic Fallback): Zero Models / Zero API Keys
#   Leave LLM_PROVIDER=none or unset. The pipeline automatically activates
#   its domain-agnostic syntactic anchor parser and calibrated analytical
#   decision pipeline with zero external model dependencies.
# ==============================================================================

# Active Provider Selection: 'ollama', 'gemini', or 'none'
LLM_PROVIDER=ollama

# Ollama settings (Local Engine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Gemini API settings (Cloud Engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings & FAISS Candidate Pruning
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.68

# Storage Paths
DATA_DIR=data
DB_PATH=data/processed/fact_knowledge.db
